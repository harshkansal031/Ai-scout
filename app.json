{
  "expo": {
    "name": "Scout AI",
    "slug": "ai-scout",
    "version": "1.0.0",
    "scheme": "aiscout",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./constants/chatbot-icon.png",
    "splash": {
      "image": "./constants/chatbot-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080B14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aiscout.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./constants/chatbot-icon.png",
        "backgroundColor": "#080B14"
      },
      "package": "com.aiscout.app"
    },
    "web": {},
    "plugins": [
      "expo-font",
      "expo-notifications",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "2251ca2d-b560-408e-b090-96d4decdcd61"
      }
    }
  }
}
