EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PROJECT_ID=
# General Gemini usage (seed scripts, ingest, etc.)
GEMINI_API_KEY=
# Dedicated key for Explore roadmaps — add as Edge secret GEMINI_ROADMAP_API_KEY (local .env does not inject into Edge)
GEMINI_ROADMAP_API_KEY=
# Optional Edge secret GEMINI_ROADMAP_MODEL e.g. gemini-2.0-flash if gemini-2.5-flash hits free-tier limits
GEMINI_ROADMAP_MODEL=
RESEND_API_KEY=
# Scripts: npm run seed:library | seed:library:replace | seed:generate
